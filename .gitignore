# Build outputs. Cargo.lock is deliberately NOT ignored: a binary that people rely on is built
# from an exact dependency set, and the lockfile is what pins it.
/target
/checks/*/target
**/*.rs.bk
*.pdb

# Mutation testing reports
/mutants.out*/

# Written by the proof listing before it is moved under target/
/kani-list.json

# Proof and fuzzing artefacts
/fuzz/target/
/fuzz/corpus/
/fuzz/artifacts/

# Editors and systems
.vscode/
.idea/
*.swp
.DS_Store
