<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="com.alanwisper.lethewis.test">

    <uses-sdk android:minSdkVersion="28" android:targetSdkVersion="37" />

    <!-- Debuggable, so that CheckJNI watches every call; libraries stay uncompressed and aligned. -->
    <application
        android:debuggable="true"
        android:extractNativeLibs="false"
        android:hasCode="true" />

    <instrumentation
        android:name=".Runner"
        android:targetPackage="com.alanwisper.lethewis.test" />
</manifest>
